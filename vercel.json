{
  "regions": [
    "fra1"
  ],
  "functions": {
    "api/generate.js": {
      "maxDuration": 15
    },
    "api/dispatch-to-willys.js": {
      "maxDuration": 60
    },
    "api/import-recipe.js": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/images/recipes/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/dist/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/icons/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/css/styles\\.([0-9a-f]{8})\\.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "buildCommand": "node scripts/build.mjs",
  "outputDirectory": "public"
}
